# =====================================================================
# MiniMax-H3 WebUI 环境变量示例
# 复制本文件为 .env 并填入真实值：cp .env.example .env
# 密钥仅通过环境变量注入，绝不写入代码 / 配置 / 数据库（V3/X4 合规）
# =====================================================================

# ───── 通用 ─────
LOG_LEVEL=INFO
CORS_ORIGINS=*

# ───── 数据库（默认 SQLite，零配置即可 docker compose up）─────
# 生产可改为 PostgreSQL，例如：
#   DATABASE_URL=postgresql+psycopg2://user:pass@db:5432/minimaxh3
DATABASE_URL=sqlite:////data/db/app.db

# ───── Redis / 异步队列（RQ）─────
REDIS_URL=redis://redis:6379/0

# ───── 后端 API 公开地址（worker 回写 / 前端可选使用）─────
# 注意：api 服务实际监听 7860（单端口部署，UI 与 API 同源），
# 此处须与 docker-compose 中 api 暴露的端口一致，否则绝对链接会指向错误端口。
BACKEND_PUBLIC_URL=http://api:7860

# ───── 引擎路由（H-04 方案B：默认开启 MiniMax 兜底）─────
USE_FALLBACK=true
FORCE_FALLBACK=false

# ───── 本地 ComfyUI（仅 GPU 容器启用，可选）─────
# 在 GPU 实例上：设为 true 并 `docker compose --profile gpu up -d`
ENABLE_COMFYUI=false
COMFYUI_URL=http://comfyui:8188
# H3 工作流路径（容器内）；请放置你导出的 ComfyUI H3 工作流
H3_WORKFLOW_PATH=/app/workflows/h3_fl2v.json
# LoRA 权重文件名（放在 ./models 目录，已挂载到 /models:ro）
H3_LORA_NAME=minimax_h3_fl2v_turbo_8step_v1.0_comfyui_bf16.safetensors
H3_LORA_STRENGTH=1.0

# ───── 本地 H3 直跑引擎（默认开启，取代 ComfyUI server 依赖）─────
# 直接子进程调用 inference/run_minimax_h3.py（vendored comfy_core）。
LOCAL_H3_ENABLED=true
# 推理脚本与 vendored 内核路径（容器内需可访问 inference/ 与 comfy_core/）
RUNNER_SCRIPT=/app/inference/run_minimax_h3.py
COMFY_CORE_DIR=/app/comfy_core
# 运行推理子进程的 Python（需含 torch / transformers / comfy 依赖，即 requirements-linux.txt）
INFERENCE_PYTHON=python
# 注意力后端：torch | sageattention | xformers | comfy_kitchen_int8
H3_ATTENTION_BACKEND=torch

# ───── MiniMax 官方兜底引擎（B2，需要 API Key）─────
# 区域：新加坡 api.minimax.chat
# ⚠️ 数据出境合规（H-04 方案B）：参考图/音频在兜底路径下会上传至 MiniMax，
#    上线前请确认已通过数据出境评估。
MINIMAX_BASE_URL=https://api.minimax.chat/v1
MINIMAX_MODEL=MiniMax-H3
MINIMAX_API_KEY=

# ───── 提示词优化 LLM（B3，OpenAI 兼容，可选）─────
# 不填则“优化提示词”按钮静默降级为原样返回（BD-01）
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=agnes-2.5-flash

# ───── 存储路径（容器内挂载卷，对应宿主 ./data 与 ./models）─────
DATA_ROOT=/data
UPLOADS_DIR=/data/uploads
OUTPUTS_DIR=/data/outputs
MODELS_DIR=/models

# ───── 单租户（O1 设计：单租户）─────
TENANT_ID=0

# ───── 上传 / 结果限制 ─────
MAX_UPLOAD_MB=200
MAX_REFERENCES=5
